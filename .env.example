# Production is the required deployment mode for Vercel.
NODE_ENV=production

# Public canonical site URL (no trailing slash is recommended).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Public R2 custom domain for non-sensitive, published media only. Do not use
# an r2.dev development URL in production.
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.example.com

# Supabase pooled connection for the Vercel application runtime.
DATABASE_URL=postgresql://postgres.project-ref:replace-with-pooled-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Supabase connection used only by Prisma CLI migration commands.
DIRECT_URL=postgresql://postgres:replace-with-direct-password@db.project-ref.supabase.co:5432/postgres

# Generate unique, 32+ character values in the deployment secret manager.
AUTH_SECRET=replace-with-a-32-character-or-longer-auth-secret
INQUIRY_HASH_SECRET=replace-with-a-different-32-character-or-longer-inquiry-secret
CRON_SECRET=replace-with-a-different-32-character-or-longer-cron-secret

# Vercel receives the client IP from its platform headers. Use nginx only for
# the Docker deployment; direct is development-only.
INQUIRY_PROXY_MODE=vercel

# Cloudflare R2's S3-compatible API endpoint and scoped API token.
STORAGE_BACKEND=r2
STORAGE_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=yueshou-private-production
STORAGE_ACCESS_KEY_ID=replace-with-r2-access-key-id
STORAGE_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Bootstrap is an explicit, one-time operator action; do not add these to
# Vercel until immediately before `pnpm prisma db seed` and remove afterward.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
BOOTSTRAP_ADMIN_CONFIRM=I_UNDERSTAND_BOOTSTRAP_ADMIN
