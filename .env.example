# Local development only. Production uses .env.docker.
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

DATABASE_URL=postgresql://yueshou:yueshou@localhost:5432/yueshou
DIRECT_URL=postgresql://yueshou:yueshou@localhost:5432/yueshou

# Generate distinct values with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-64-hex-character-auth-secret
INQUIRY_HASH_SECRET=replace-with-a-different-64-hex-character-inquiry-secret
CRON_SECRET=replace-with-a-different-64-hex-character-cron-secret

INQUIRY_PROXY_MODE=direct
STORAGE_BACKEND=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=yueshou-local
STORAGE_ACCESS_KEY_ID=replace-with-local-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-local-secret-key

# Set these only for the one-time seed of an empty local database.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
BOOTSTRAP_ADMIN_CONFIRM=I_UNDERSTAND_BOOTSTRAP_ADMIN
