# Copy to .env.docker. Do not use these placeholder values in production.
# URL-encode reserved characters in POSTGRES_PASSWORD because it is interpolated
# into DATABASE_URL and DIRECT_URL below.
POSTGRES_DB=yueshou
POSTGRES_USER=yueshou
POSTGRES_PASSWORD=replace-with-a-long-url-safe-postgres-password

# MinIO root credentials are administration credentials; use distinct values.
MINIO_ROOT_USER=replace-with-a-minimum-3-character-root-user
MINIO_ROOT_PASSWORD=replace-with-a-minimum-8-character-root-password
STORAGE_ACCESS_KEY_ID=replace-with-a-scoped-minio-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-a-scoped-minio-secret-key
STORAGE_BUCKET=yueshou-private-production

# Generate three distinct 64-hex-character values: openssl rand -hex 32
AUTH_SECRET=replace-with-a-64-hex-character-auth-secret
INQUIRY_HASH_SECRET=replace-with-a-different-64-hex-character-inquiry-secret
CRON_SECRET=replace-with-a-different-64-hex-character-cron-secret
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Absolute host path containing fullchain.pem and privkey.pem, mounted read-only.
TLS_CERTS_DIR=/absolute/path/to/tls-certificates

# Backups are AES-256 encrypted. Generate a unique long passphrase and retain it
# offline; loss of this secret makes backups unrecoverable.
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-unique-backup-passphrase
BACKUP_INTERVAL_SECONDS=86400
